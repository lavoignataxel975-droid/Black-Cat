# Sans DATABASE_URL, le CMS utilise une base PostgreSQL embarquée (PGlite) dans ./data/pglite.
# En production, renseigner une vraie base PostgreSQL :
# DATABASE_URL=postgres://user:password@host:5432/sgt

# Dossier de stockage des médias (par défaut ./storage)
# STORAGE_DIR=./storage

# URL publique du CMS (utilisée pour construire les URL des images)
PUBLIC_URL=http://localhost:3200
